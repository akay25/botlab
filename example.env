# Environment configuration
ENV=dev

# Application configuration
APP_NAME=botlab
# Loopback keeps the harness on this machine. Set 0.0.0.0, or pass
# --host 0.0.0.0, to drive the task page from a phone or another computer.
# There is no authentication, so do that only on a network you trust.
APP_HOST=127.0.0.1
APP_PORT=8443
ALLOWED_HOSTS=*

# Logging configuration
LOG_LEVEL=INFO

# TLS configuration
# The harness signs its own certificate, because it is a local test origin.
# Turn this off only to debug the page: the tls layer then reports no data.
TLS_ENABLED=true
# uvicorn listens here and the ClientHello-reading front end listens on
# APP_PORT. Leave at 0 to use APP_PORT + 1.
TLS_UPSTREAM_PORT=0
# Extra names or addresses the certificate must cover, comma separated. Only
# needed when clients reach the harness by a name this machine cannot resolve
# for itself, such as a DNS alias or a tunnel.
CERT_HOSTS=

# Storage configuration
# Scored sessions are appended to $DATA_DIR/sessions.jsonl with their raw
# telemetry, so a run can be re-scored later. Leave DATA_DIR unset to use
# ./data next to the project.
SESSION_CACHE_SIZE=500
