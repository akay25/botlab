# Environment configuration
ENV=dev

# Application configuration
APP_NAME=botlab
APP_HOST=127.0.0.1
APP_PORT=8443
ALLOWED_HOSTS=*

# Logging configuration
LOG_LEVEL=INFO

# TLS configuration
# The harness signs its own certificate, because it is a local test origin.
# Turn this off only to debug the page: the tls layer then reports no data.
TLS_ENABLED=true
# uvicorn listens here and the ClientHello-reading front end listens on
# APP_PORT. Leave at 0 to use APP_PORT + 1.
TLS_UPSTREAM_PORT=0

# Storage configuration
# Scored sessions are appended to $DATA_DIR/sessions.jsonl with their raw
# telemetry, so a run can be re-scored later. Leave DATA_DIR unset to use
# ./data next to the project.
SESSION_CACHE_SIZE=500
