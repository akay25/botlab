{
  "manifest_version": 3,
  "name": "botlab probe",
  "version": "1.0",
  "description": "Measure the browser that runs it. Compare the main world with the isolated world to find stealth patches.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "botlab probe"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
